TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional: actual local Chrome CDP endpoint when automatic discovery misses
# a custom profile/port. Example only; verify your running browser's endpoint.
# BU_CDP_URL=http://127.0.0.1:9224
# Optional for jev-codex (the current conversation supplies text).
# Required for the original jev inspector or --text-provider api.
# OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
